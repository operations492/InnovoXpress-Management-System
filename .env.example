# Copy to .env. The backend defaults to port 4000.
VITE_API_URL=http://localhost:4000

# Supabase Auth. Both values are PUBLIC by design — the publishable key is meant
# to ship in the browser bundle, and grants nothing on its own: every table has
# row-level security enabled with no policies, and the API checks the user's role
# server-side.
#
# Find them in the Supabase dashboard under Settings -> API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
